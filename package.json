{
  "name": "sai-creations-catalogue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run images",
    "dev": "next dev",
    "prebuild": "npm run images",
    "build": "next build",
    "preview": "serve out -l 3000",
    "images": "node scripts/build-images.mjs",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:todo": "node scripts/content-todo-report.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "verify:export": "node scripts/verify-export.mjs",
    "postbuild": "npm run verify:export",
    "test": "node --test \"lib/**/*.test.ts\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.7",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "description": "Static catalogue website for SAI Creations International",
  "engines": {
    "node": ">=22.12"
  }
}
